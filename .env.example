# Copy file nay thanh .env (local) hoac khai bao truc tiep trong
# Vercel Dashboard > Project Settings > Environment Variables

# Pixel ID lay tai: Events Manager > Data Sources > chon Pixel
FB_PIXEL_ID=

# Access token CAPI, tao tai: Events Manager > pixel > Settings > Conversions API
# (nen tao qua System User trong Business Settings de token khong bi het han)
FB_ACCESS_TOKEN=

# Ma test lay tai tab "Test Events" trong Events Manager
# CHI dung khi test, XOA bien nay khi chay chien dich that
FB_TEST_EVENT_CODE=

# (Tuy chon) URL webhook de luu lead vao Google Sheet / CRM khac
SHEET_WEBHOOK_URL=
